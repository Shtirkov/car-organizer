# ============================================================
#  Car Maintenance Tracker — .gitignore
# ============================================================

# ---- Product docs (kept out of the repo) ----
Car_Maintenance_Tracker_PRD_v1.docx
*.docx
~$*.docx

# ---- Local working notes (not committed) ----
# CLAUDE.md is committed (shared project knowledge); personal/machine-specific notes go here:
CLAUDE.local.md

# ---- .NET / build output ----
bin/
obj/
out/
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
artifacts/
*.user
*.suo
*.userosscache
*.sln.docstates
project.lock.json
*.nupkg
*.snupkg
TestResults/
[Tt]est[Rr]esults/
*.coverage
*.coveragexml
coverage/
*.trx
msbuild.log
msbuild.err
msbuild.wrn

# ---- EF Core ----
*.mdf
*.ldf

# ---- Node / React / Vite ----
node_modules/
dist/
dist-ssr/
.vite/
*.local
.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Environment / secrets ----
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json
*.pfx
secrets.json

# ---- IDE / editors ----
.vs/
.vscode/
.idea/
*.swp
*~

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
logs/
*.log

# ---- Uploaded documents (LocalFileStorage root; replaced by R2 in Phase 8) ----
App_Data/

# ---- Agent skills ----
# The installed skill tree is vendored third-party content — treat it like node_modules
# and reinstall with `npx skills add mattpocock/skills`. skills-lock.json is the lockfile
# that pins each skill's source and hash, so it IS committed.
.claude/skills/

# ---- Backend gap catalogue (superseded by GitHub issues, 12 Aug 2026) ----
# Every FEATURE.md and story became an issue (#1-#48), so the files would be a second
# copy that drifts. Kept locally as a scratch copy; the issues are the live version.
docs/backend-gaps/
